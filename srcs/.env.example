POSTGRES_USER=transcendence
POSTGRES_PASSWORD=change_me
POSTGRES_DB=transcendence

POSTGRES_HOST=postgres
POSTGRES_PORT=5432

BACKEND_PORT=3001
FRONTEND_PORT=5173

# The browser talks to the backend exclusively through the HTTPS proxy
# (https-proxy service, self-signed cert). Host-side port is 8443, not 443:
# rootless Podman can't bind <1024 without extra host privileges. First visit
# https://localhost:8443 once and accept the self-signed certificate warning,
# otherwise the frontend's requests to it will silently fail.
VITE_API_URL=https://localhost:8443


JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1h

FRONTEND_URL=http://localhost:5173

# 42 intra OAuth app (https://profile.intra.42.fr/oauth/applications) — leave
# empty to disable "Se connecter avec 42"; the redirect URI must match exactly
# what you register there.
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
FORTYTWO_CALLBACK_URL=https://localhost:8443/auth/42/callback

# SMTP for GDPR confirmation emails (account deletion / data export). Leave
# empty to disable sending — the action itself still happens, only the email
# notification is skipped (logged instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@ft-transcendence.local
